NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Optional: AI form pre-check endpoint
# NEXT_PUBLIC_AI_REVIEW_URL=

# ── Online entry-fee payment (SSLCommerz) ── server-side secrets: never prefix with NEXT_PUBLIC_
# Supabase → Project Settings → API → "service_role" / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox keys: https://developer.sslcommerz.com/registration/  (free test account)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "false" = sandbox (test money). Set "true" only with live keys from your SSLCommerz merchant panel.
SSLCOMMERZ_LIVE=false
# Public https address of your site (needed for the webhook/IPN). Leave empty on localhost.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
